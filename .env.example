# Video Conferencing App - Environment Variables
# Copy to .env.local and adjust for your deployment

# ============ Frontend (Next.js) ============
# Socket.io server URL - use your server's public URL in production
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Live classes (classroom-api + 100ms) — REST + Socket.IO
NEXT_PUBLIC_CLASSROOM_API_URL=http://localhost:4000

# ============ Backend (Server) ============
# HTTP port for the SFU server
PORT=3001

# CORS origin - allow frontend to connect (Next.js dev: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# MediaSoup workers - defaults to CPU count if not set
# NUM_WORKERS=4

# Network - for production behind NAT/firewall
# Your server's public IP - required for WebRTC ICE to work across networks
# ANNOUNCED_IP=your.public.ip.or.domain

# WebRTC port range (UDP + TCP). Use a wide range in production (default 40000–49999).
# WEBRTC_PORT_MIN=40000
# WEBRTC_PORT_MAX=49999

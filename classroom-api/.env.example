NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/classroom
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
# SOCKET_CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# REDIS_URL=redis://127.0.0.1:6379

# 100ms dashboard → Developer
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=
HMS_ROLE_TEACHER=host
HMS_ROLE_STUDENT=viewer
HMS_AUTH_TOKEN_TTL_SECONDS=3600

# Optional: require invite codes for elevated roles at registration
# TEACHER_INVITE_CODE=
# ADMIN_INVITE_CODE=

# Webhook HMAC (must match 100ms dashboard configuration)
# HMS_WEBHOOK_SECRET=

# Optional S3 for private recording objects + signed playback
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=3600

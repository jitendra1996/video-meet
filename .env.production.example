# =============================================================================
# Production — copy and customize
# =============================================================================
# Next.js (this repo root):
#   cp .env.production.example .env.production
#   npm run build && npm start
#
# SFU server (`server/`): set the same "Backend" variables in your process
# environment (Docker, systemd, PaaS dashboard, or `export` before npm run start).
#
# Use HTTPS URLs in the browser. Open firewall UDP (and TCP fallback) for the
# WebRTC port range on the SFU host.

# ============ Frontend (Next.js — NEXT_PUBLIC_* is inlined at build time) ============
# Must be present when you run: npm run build
# (Putting this only in PM2 env for `next start` is NOT enough — rebuild after changing.)
NEXT_PUBLIC_SOCKET_URL=https://sfu.yourdomain.com

# Live classes API (REST + Socket.IO). Inlined at `npm run build` — set before build.
NEXT_PUBLIC_CLASSROOM_API_URL=https://api.classroom.yourdomain.com

# If WebSocket upgrade fails behind nginx (console: wss://.../socket.io failed) but
# the SFU is up, set polling-only until nginx has map $http_upgrade (see deploy/nginx-map-connection-upgrade.conf):
# NEXT_PUBLIC_SOCKET_TRANSPORTS=polling

# Optional: JSON array passed to RTCPeerConnection as iceServers (STUN/TURN).
# Rebuild Next after changing. Credentials are visible in the client — use
# short-lived TURN credentials from your backend in serious deployments.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_IP:3478","username":"turnuser","credential":"turnpass"}]

# ============ Backend (Node SFU — not read by Next.js; set on server deploy) ============
NODE_ENV=production
PORT=3001

# Comma-separated origins allowed to use Socket.io (your Next.js app URL(s))
CORS_ORIGIN=https://meet.yourdomain.com

# Bind address for MediaSoup ICE listeners
LISTEN_IP=0.0.0.0

# Public IPv4 or DNS name clients must use for WebRTC (not localhost)
ANNOUNCED_IP=203.0.113.50

# MediaSoup worker count (optional; default = CPU cores, max 16 in app config)
# NUM_WORKERS=8

# WebRTC media ports on the SFU host — must be wide enough for all transports
# (each participant needs send + recv; default in app is 40000–49999 ≈ 10k ports).
# If you lowered this to ~101 ports, you will see "no more available ports".
WEBRTC_PORT_MIN=40000
WEBRTC_PORT_MAX=49999
